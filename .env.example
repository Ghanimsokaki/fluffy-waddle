# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# The ".env" file is git-ignored and is read ONLY by the server.
# No secret is ever sent to the browser.
# ---------------------------------------------------------------------------

# --- Hugging Face ----------------------------------------------------------
# Create a token at https://huggingface.co/settings/tokens
# (create a NEW one - any token you pasted into a chat should be revoked first)
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1

# --- OpenRouter (gives you the catalogue of :free models) ------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Dedicated HF Inference Endpoint (optional) ----------------------------
# If set, the Hugging Face provider calls this endpoint instead of the shared
# router. This is the way to serve a model the router will not host, e.g. the
# Gemby-2-agent 3B model. The endpoint's OpenAI-compatible base URL looks like:
#   https://<endpoint-id>.<region>.aws.endpoints.huggingface.cloud/v1
HF_ENDPOINT_URL=

# --- MCP servers for serverless hosts (Vercel) -----------------------------
# On Vercel the filesystem is read-only, so servers added from the UI are not
# persisted. Provide them here as a JSON array instead. Only "http" servers
# work on Vercel (stdio cannot spawn processes there). Example:
# MCP_SERVERS=[{"id":"search","name":"Search","transport":"http","url":"https://example.com/mcp"}]
MCP_SERVERS=

# --- Defaults used by the UI on first load ---------------------------------
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=google/gemma-4-31b-it:free

# --- HTTP server -----------------------------------------------------------
PORT=3000
